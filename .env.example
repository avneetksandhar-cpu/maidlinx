# =============================================================================
# MaidLinx — copy to .env.local and fill real values (never commit .env.local)
#   cp .env.example .env.local
# Dev server: npm run dev  →  http://localhost:3001
# =============================================================================

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=MaidLinx

# -----------------------------------------------------------------------------
# Supabase (required for bookings, auth, admin, cleaner)
# Dashboard → Project Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — Project Settings → API → service_role (keep secret)
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Stripe TEST mode (required for checkout)
# https://dashboard.stripe.com/test/apikeys
# Local webhooks: stripe listen --forward-to localhost:3001/api/webhooks/stripe
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# From `stripe listen` output (whsec_...)
STRIPE_WEBHOOK_SECRET=

# Payments — percent of booking total charged as deposit at checkout
DEPOSIT_PERCENT=25
NEXT_PUBLIC_DEPOSIT_PERCENT=25

# -----------------------------------------------------------------------------
# Google Maps Places (optional — booking address autocomplete + current location)
# Browser key only (NEXT_PUBLIC_). Restrict by HTTP referrer in Cloud Console.
# Enable Places API + Maps JavaScript API + Geocoding API (+ billing), paste key, restart dev.
# Without this key, users can still type addresses manually.
# See docs/GOOGLE_MAPS_SETUP.md
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# Email / SMS (defaults to log — safe for local smoke tests)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM=MaidLinx <bookings@maidlinx.com>

SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Monitoring (optional — production: both set from Sentry project maidlinx-production)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# SENTRY_AUTH_TOKEN=   # build-time source maps only; never commit

# First sign-in with this email is promoted to admin (profiles.role = admin)
ADMIN_BOOTSTRAP_EMAIL=

# HMAC secret for guest booking access tokens (falls back to STRIPE_WEBHOOK_SECRET)
BOOKING_ACCESS_SECRET=

# -----------------------------------------------------------------------------
# DEV_TEST_BOOKING — skip Stripe card for local ops testing
# NEVER set in production. Server forces off when NODE_ENV=production.
# Defaults to disabled if unset. Requires NODE_ENV !== production AND:
#   ALLOW_DEV_TEST_BOOKING=true  (or alias ALLOW_DEV_BOOKING=true)
# Creates awaiting_assignment booking with a synthetic payment record.
# -----------------------------------------------------------------------------
ALLOW_DEV_TEST_BOOKING=true
# ALLOW_DEV_BOOKING=true
