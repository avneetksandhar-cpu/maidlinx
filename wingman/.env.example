# =============================================================================
# Wingman — Environment Variables
# Copy to .env.local and fill in values. Never commit real secrets.
# =============================================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3005

# Auth provider: Sprint 1 uses Neon + session cookies.
# "supabase" or "clerk" remain available for later work.
NEXT_PUBLIC_AUTH_PROVIDER=supabase

# -----------------------------------------------------------------------------
# Neon / Lakebase Postgres (Sprint 1 database)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
AUTH_DEV_RESET=true
AUTH_SECRET=change-me-to-a-long-random-secret
# Shared local seed password for Gmail plus-alias accounts (see db/seed-accounts.ts).
SEED_PASSWORD=change-me-to-a-long-local-password

# -----------------------------------------------------------------------------
# Supabase (optional; not required for Sprint 1 auth)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Clerk (only if NEXT_PUBLIC_AUTH_PROVIDER=clerk)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# -----------------------------------------------------------------------------
# Stripe — TEST MODE ONLY. Live keys are rejected by the app.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Private TEST booking fixtures (admin/test mode only). Never public.
# Set true locally to seed one TEST Wingman / offer / event / customer.
# Set false and re-run npm run seed to remove them before production.
ENABLE_TEST_FIXTURES=false

# -----------------------------------------------------------------------------
# Google Maps
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# -----------------------------------------------------------------------------
# OneSignal
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key

# -----------------------------------------------------------------------------
# Daily Miami event sync (server-only — never expose to the client)
# -----------------------------------------------------------------------------
# Required to trigger /api/cron/event-sync. Admin "Sync now" works with an operator session.
EVENT_SYNC_SECRET=

# Ticketmaster Discovery API. If missing, the adapter skips with a structured log.
# Request a key at https://developer.ticketmaster.com/ — do not invent one.
TICKETMASTER_API_KEY=

# Optional PredictHQ. If missing, the adapter skips.
PREDICTHQ_TOKEN=
